# =============================================================================
# FynnCloud Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Strong password for the PostgreSQL database user 'fynncloud'.
# If left as 'changeme', start.sh will automatically generate a secure secret.
DB_PASSWORD=changeme

# Automatically run database migrations on server startup (recommended: true)
# Canonical: DATABASE_AUTO_MIGRATE (Legacy alias: AUTO_MIGRATE)
DATABASE_AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# 2. Security & Encryption (REQUIRED)
# -----------------------------------------------------------------------------
# Secret key used for signing authentication JWTs (min 32 random characters).
# If left empty, start.sh will automatically generate one using openssl.
# Canonical: AUTH_JWT_SECRET (Legacy alias: JWT_SECRET)
AUTH_JWT_SECRET=

# Symmetric 256-bit encryption key used to encrypt sensitive data at rest
# (such as TOTP 2FA secret keys). REQUIRED - the backend refuses to start without it.
# IMPORTANT: Keep this safe and back it up! If lost or changed, stored 2FA secrets
# cannot be decrypted, requiring affected users to re-enroll.
# If left empty, start.sh will automatically generate one using openssl.
# Canonical: SECURITY_ENCRYPTION_KEY (Legacy aliases: APP_ENCRYPTION_KEY, ENCRYPTION_KEY)
SECURITY_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 3. Ports & URLs
# -----------------------------------------------------------------------------
# Port for the public Nginx reverse proxy (default: 80)
PROXY_PORT=80

# Internal ports (used when running individual services directly or in dev mode)
BACKEND_PORT=8080
FRONTEND_PORT=3000
EUROOFFICE_PORT=8082

# Public URL of your FynnCloud instance (e.g., https://cloud.example.com or http://localhost)
# Canonical: APP_FRONTEND_URL (Legacy alias: FRONTEND_URL)
APP_FRONTEND_URL=http://localhost

# Allowed CORS origins for the API (comma-separated or wildcard '*')
# Canonical: SERVER_CORS_ALLOWED_ORIGINS (Legacy alias: CORS_ALLOWED_ORIGINS)
SERVER_CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 4. Application Branding & General
# -----------------------------------------------------------------------------
# Instance display name shown in navigation and page titles
# Canonical: BRANDING_APP_NAME (Legacy alias: APP_NAME)
BRANDING_APP_NAME=FynnCloud

# Primary theme color (preset name e.g. 'blue', 'indigo', 'emerald' or hex '#3B82F6')
# Canonical: BRANDING_PRIMARY_COLOR (Legacy alias: PRIMARY_COLOR)
BRANDING_PRIMARY_COLOR=blue

# Display instance name alongside custom logo: 'true' or 'false'
# Canonical: BRANDING_SHOW_LOGO_AND_NAME
BRANDING_SHOW_LOGO_AND_NAME=false

# -----------------------------------------------------------------------------
# 5. File Upload & Size Limits
# -----------------------------------------------------------------------------
# Maximum chunk size for multipart uploads (in megabytes)
# Canonical: STORAGE_MAX_CHUNK_SIZE (Legacy alias: MAX_CHUNK_SIZE)
STORAGE_MAX_CHUNK_SIZE=100

# Maximum HTTP request body size (in megabytes for Nginx proxy & Vapor routes)
# Canonical: MAX_BODY_SIZE (Aliases: SERVER_MAX_BODY_SIZE, STORAGE_MAX_BODY_SIZE)
MAX_BODY_SIZE=100

# Trash retention period before automatic permanent cleanup (in days, 1-3650)
# Canonical: STORAGE_TRASH_RETENTION_DAYS (Legacy alias: TRASH_RETENTION_DAYS)
STORAGE_TRASH_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 6. Redis Cache & Job Queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# 6b. Semantic Search & Embeddings (OpenAI-compatible) (OPTIONAL)
# -----------------------------------------------------------------------------
# Base URL for the OpenAI-compatible embedding service (e.g. http://localhost:8000 or https://api.openai.com/v1)
# Leave empty to disable semantic search.
# Canonical: AI_EMBEDDING_URL (Legacy alias: EMBEDDING_URL)
AI_EMBEDDING_URL=

# Optional API key for the embedding provider (e.g. OpenAI API key if using commercial provider)
# Canonical: AI_EMBEDDING_API_KEY (Legacy alias: EMBEDDING_API_KEY)
AI_EMBEDDING_API_KEY=

# Model identifier to request from the embedding provider (default: jinaai/jina-clip-v2)
# Canonical: AI_EMBEDDING_MODEL (Legacy alias: EMBEDDING_MODEL)
AI_EMBEDDING_MODEL=jinaai/jina-clip-v2

# -----------------------------------------------------------------------------
# 7. In-Browser Document Editing (EuroOffice / OnlyOffice) (OPTIONAL)
# -----------------------------------------------------------------------------
# Public base URL of the EuroOffice document server (requires its own dedicated subdomain with HTTPS in production).
# Leave empty to disable in-browser document editing.
# Example: https://office.example.com (or http://localhost:8082 for local dev)
# Canonical: DOCS_SERVER_URL (Legacy aliases: DOCUMENT_SERVER_URL, EUROOFFICE_URL)
DOCS_SERVER_URL=

# Office provider type: 'eurooffice' (native DocsAPI, recommended) or 'wopi'
# Canonical: DOCS_PROVIDER (Legacy alias: OFFICE_PROVIDER)
DOCS_PROVIDER=eurooffice

# Shared JWT secret used between the backend and EuroOffice for document signing.
# If left empty, start.sh will automatically generate one.
# Canonical: DOCS_JWT_SECRET (Legacy aliases: EUROOFFICE_JWT_SECRET, DOCUMENT_SERVER_JWT_SECRET)
DOCS_JWT_SECRET=

# Public base URL the document server uses to call back FynnCloud.
# Defaults to FRONTEND_URL if left empty.
# Canonical: DOCS_WOPI_PUBLIC_URL (Legacy alias: WOPI_PUBLIC_URL)
DOCS_WOPI_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 8. S3 / Object Storage (OPTIONAL)
# -----------------------------------------------------------------------------
# By default, files are stored on local persistent Docker volume storage.
# Uncomment and configure the following to store files in AWS S3, MinIO, or Cloudflare R2:
# Canonical: STORAGE_S3_BUCKET (Legacy alias: S3_BUCKET)
# STORAGE_S3_BUCKET=my-fynncloud-bucket
# STORAGE_AWS_ACCESS_KEY_ID=your_access_key
# STORAGE_AWS_SECRET_ACCESS_KEY=your_secret_key
# STORAGE_AWS_REGION=us-east-1
# STORAGE_AWS_ENDPOINT=https://s3.amazonaws.com

# -----------------------------------------------------------------------------
# 9. Rate Limiting & Protection (OPTIONAL)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH=10
RATE_LIMIT_SHARE=60
RATE_LIMIT_API=300

# -----------------------------------------------------------------------------
# 10. Single Sign-On (LDAP / OpenID Connect) (OPTIONAL)
# -----------------------------------------------------------------------------
# LDAP / Active Directory:
# SSO_LDAP_ENABLED=false
# SSO_LDAP_HOST=ldap.example.com
# SSO_LDAP_PORT=389
# SSO_LDAP_USE_SSL=false
# SSO_LDAP_BASE_DN=dc=example,dc=com
# SSO_LDAP_BIND_DN=cn=admin,dc=example,dc=com
# SSO_LDAP_BIND_PASSWORD=secret

# OpenID Connect (OIDC / Keycloak / Authentik / Google):
# SSO_OIDC_ENABLED=false
# SSO_OIDC_DISPLAY_NAME=Company SSO
# SSO_OIDC_ISSUER_URL=https://auth.example.com/realms/master
# SSO_OIDC_CLIENT_ID=fynncloud
# SSO_OIDC_CLIENT_SECRET=your_oidc_secret
