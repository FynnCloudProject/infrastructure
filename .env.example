# =============================================================================
# FynnCloud Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Strong password for the PostgreSQL database user 'fynncloud'.
# If left as 'changeme', start.sh will automatically generate a secure secret.
DB_PASSWORD=changeme

# Automatically run database migrations on server startup (recommended: true)
AUTO_MIGRATE=true

# -----------------------------------------------------------------------------
# 2. Security & Encryption (REQUIRED)
# -----------------------------------------------------------------------------
# Secret key used for signing authentication JWTs (min 32 random characters).
# If left empty, start.sh will automatically generate one using openssl.
JWT_SECRET=

# Symmetric 256-bit encryption key used to encrypt sensitive data at rest
# (such as TOTP 2FA secret keys). REQUIRED — the backend refuses to start without it.
# IMPORTANT: Keep this safe and back it up! If lost or changed, stored 2FA secrets
# cannot be decrypted, requiring affected users to re-enroll.
# If left empty, start.sh will automatically generate one using openssl.
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# 3. Ports & URLs
# -----------------------------------------------------------------------------
# Port for the public Nginx reverse proxy (default: 80)
PROXY_PORT=80

# Internal ports (used when running individual services directly or in dev mode)
BACKEND_PORT=8080
FRONTEND_PORT=3000
EUROOFFICE_PORT=8082

# Public URL of your FynnCloud instance (e.g., https://cloud.example.com or http://localhost)
FRONTEND_URL=http://localhost

# Allowed CORS origins for the API (comma-separated or wildcard '*')
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 4. Application Branding & General
# -----------------------------------------------------------------------------
# Instance display name shown in navigation and page titles
APP_NAME=FynnCloud

# Primary theme color (preset name e.g. 'blue', 'indigo', 'emerald' or hex '#3B82F6')
PRIMARY_COLOR=blue

# -----------------------------------------------------------------------------
# 5. File Upload & Size Limits
# -----------------------------------------------------------------------------
# Maximum chunk size for multipart uploads (in megabytes)
MAX_CHUNK_SIZE=100

# Maximum HTTP request body size (in megabytes)
MAX_BODY_SIZE=100

# Trash retention period before automatic permanent cleanup (in days, 1-3650)
TRASH_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 6. Redis Cache & Job Queue
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# 7. In-Browser Document Editing (EuroOffice / OnlyOffice) (OPTIONAL)
# -----------------------------------------------------------------------------
# Public base URL of the EuroOffice document server (requires its own dedicated subdomain with HTTPS in production).
# Leave empty to disable in-browser document editing.
# Example: https://office.example.com (or http://localhost:8082 for local dev)
DOCUMENT_SERVER_URL=

# Office provider type: 'eurooffice' (native DocsAPI, recommended) or 'wopi'
OFFICE_PROVIDER=eurooffice

# Shared JWT secret used between the backend and EuroOffice for document signing.
# If left empty, start.sh will automatically generate one.
EUROOFFICE_JWT_SECRET=

# Public base URL the document server uses to call back FynnCloud.
# Defaults to FRONTEND_URL if left empty.
WOPI_PUBLIC_URL=

# -----------------------------------------------------------------------------
# 8. S3 / Object Storage (OPTIONAL)
# -----------------------------------------------------------------------------
# By default, files are stored on local persistent Docker volume storage.
# Uncomment and configure the following to store files in AWS S3, MinIO, or Cloudflare R2:
# S3_BUCKET=my-fynncloud-bucket
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_ENDPOINT=https://s3.amazonaws.com

# -----------------------------------------------------------------------------
# 9. Rate Limiting & Protection (OPTIONAL)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_AUTH=10
RATE_LIMIT_SHARE=60
RATE_LIMIT_API=300

# -----------------------------------------------------------------------------
# 10. Single Sign-On (LDAP / OpenID Connect) (OPTIONAL)
# -----------------------------------------------------------------------------
# LDAP / Active Directory:
# LDAP_ENABLED=false
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# LDAP_USE_SSL=false
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=secret

# OpenID Connect (OIDC / Keycloak / Authentik / Google):
# OIDC_ENABLED=false
# OIDC_DISPLAY_NAME=Company SSO
# OIDC_ISSUER_URL=https://auth.example.com/realms/master
# OIDC_CLIENT_ID=fynncloud
# OIDC_CLIENT_SECRET=your_oidc_secret
